APP_NAME=GravitySingularity
APP_ENV=production
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_POOL_SIZE=60
DATABASE_MAX_OVERFLOW=140
DATABASE_POOL_TIMEOUT=120

REDIS_URL=rediss://default:YOUR_TOKEN@your-instance.upstash.io:6379?ssl_cert_reqs=none
