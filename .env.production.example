APP_NAME=GravitySingularity
APP_ENV=production
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

REDIS_URL=rediss://default:YOUR_TOKEN@your-instance.upstash.io:6379?ssl_cert_reqs=none
CELERY_BROKER_URL=rediss://default:YOUR_TOKEN@your-instance.upstash.io:6379?ssl_cert_reqs=none
CELERY_RESULT_BACKEND=rediss://default:YOUR_TOKEN@your-instance.upstash.io:6379?ssl_cert_reqs=none
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True
CELERY_BROKER_HEARTBEAT=20
CELERY_BROKER_POOL_LIMIT=0
CELERY_BROKER_SOCKET_CONNECT_TIMEOUT=30
CELERY_BROKER_SOCKET_TIMEOUT=30
CELERY_REDIS_HEALTH_CHECK_INTERVAL=15
CELERY_REDIS_MAX_RETRIES=20
CELERY_WORKER_CANCEL_LONG_RUNNING_TASKS_ON_CONNECTION_LOSS=False

WRITER_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_HTTPS_PROXY=
OPENAI_WRITER_MODEL=gpt-5.5
OPENAI_WRITER_REASONING_EFFORT=xhigh
OPENAI_WRITER_VERBOSITY=medium
OPENAI_WRITER_MAX_OUTPUT_TOKENS=60000

IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.tu-zi.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=
IMAGE_RESPONSE_FORMAT=
IMAGE_OUTPUT_FORMAT=

GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=video-plan2
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/app/backend/YOUR_SERVICE_ACCOUNT.json
GOOGLE_HTTPS_PROXY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_TO_API_KEY=False
GEMINI_REQUEST_TIMEOUT=30
GEMINI_REFINE_REQUEST_TIMEOUT=240
GEMINI_MAX_RETRIES=1
GEMINI_THINKING_BUDGET=0
GEMINI_POLISH_CALL_TIMEOUT=45
GEMINI_REFINE_CALL_TIMEOUT=180
GEMINI_POLISH_MAX_OUTPUT_TOKENS=4096
GEMINI_REFINE_MAX_OUTPUT_TOKENS=60000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FORMAT_MAX_TOKENS=20000
DEEPSEEK_REQUEST_TIMEOUT=180
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_FORMAT_CALL_TIMEOUT=1800

QINGDOU_API_KEY=
QINGDOU_BASE_URL=https://www.qingdou.vip/web/api/commitGetTextTask
QINGDOU_MAX_VIDEO_DURATION=900
QINGDOU_POLL_INTERVAL_SECONDS=3
QINGDOU_POLL_TIMEOUT_SECONDS=300

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=168
CORS_ALLOW_ORIGINS=https://sheke.asia,https://www.sheke.asia
