APP_NAME=GravitySingularity
APP_ENV=production
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_POOL_SIZE=60
DATABASE_MAX_OVERFLOW=140
DATABASE_POOL_TIMEOUT=120

REDIS_URL=rediss://default:YOUR_TOKEN@your-instance.upstash.io:6379?ssl_cert_reqs=none
CELERY_BROKER_URL=rediss://default:YOUR_TOKEN@your-instance.upstash.io:6379?ssl_cert_reqs=none
CELERY_RESULT_BACKEND=rediss://default:YOUR_TOKEN@your-instance.upstash.io:6379?ssl_cert_reqs=none
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True
CELERY_BROKER_HEARTBEAT=20
CELERY_BROKER_POOL_LIMIT=0
CELERY_BROKER_SOCKET_CONNECT_TIMEOUT=30
CELERY_BROKER_SOCKET_TIMEOUT=30
CELERY_REDIS_HEALTH_CHECK_INTERVAL=15
CELERY_REDIS_MAX_RETRIES=20
CELERY_WORKER_CANCEL_LONG_RUNNING_TASKS_ON_CONNECTION_LOSS=False
CELERY_WORKER_CONCURRENCY=200
MAX_ACTIVE_GENERATION_TASKS=250
GENERATION_TASK_MAX_RETRIES=5
GENERATION_TASK_RETRY_BACKOFF_SECONDS=60
STALE_TASK_WATCHDOG_ENABLED=True
STALE_TASK_WATCHDOG_INTERVAL_SECONDS=120
TASK_RUN_HEARTBEAT_INTERVAL_SECONDS=60
STALE_PROCESSING_REQUEUE_SECONDS=900
FAILED_TASK_AUTO_RECOVERY_ENABLED=True
FAILED_TASK_AUTO_RECOVERY_SECONDS=600
FAILED_TASK_AUTO_RECOVERY_MAX_ATTEMPTS=24
PAID_API_GATE_WAIT_TIMEOUT_SECONDS=14400
PAID_API_GATE_TTL_SECONDS=600

WRITER_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Production should use the Beijing ECS -> Japan proxy service path.
# The systemd tunnel binds this address on the Beijing ECS Docker bridge
# and forwards to the HTTP proxy on the Japan server.
OPENAI_HTTPS_PROXY=http://PROXY_USER:PROXY_PASSWORD@172.18.0.1:7896
OPENAI_WRITER_MODEL=gpt-5.5
OPENAI_WRITER_REASONING_EFFORT=xhigh
OPENAI_WRITER_VERBOSITY=medium
OPENAI_WRITER_MAX_OUTPUT_TOKENS=60000
OPENAI_WRITER_MAX_RETRIES=3
OPENAI_WRITER_RETRY_BACKOFF_SECONDS=8
OPENAI_WRITER_STREAM=False
OPENAI_WRITER_MAX_CONCURRENT_CALLS=16

IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.tu-zi.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=
IMAGE_RESPONSE_FORMAT=
IMAGE_OUTPUT_FORMAT=
IMAGE_MAX_CONCURRENT_CALLS=4
IMAGE_API_MAX_RETRIES=1
IMAGE_GATE_WAIT_TIMEOUT_SECONDS=30
COVER_WORKFLOW_ENABLED=True
COVER_BOOK_TASK_GENERATION_ENABLED=False
COVER_TASK_MAX_RETRIES=360
COVER_TASK_RETRY_SECONDS=60
COVER_JOB_MAX_ROWS=500
COVER_REFERENCE_FETCH_ENABLED=True
COVER_REFERENCE_CACHE_ENABLED=False
COVER_REFERENCE_DOWNLOAD_IMAGES=False
COVER_REFERENCE_CACHE_DIR=dangdang_book_covers
COVER_REFERENCE_TIMEOUT_SECONDS=12

GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=video-plan2
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/app/backend/YOUR_SERVICE_ACCOUNT.json
GOOGLE_HTTPS_PROXY=http://PROXY_USER:PROXY_PASSWORD@172.18.0.1:7896
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_TO_API_KEY=False
GEMINI_REQUEST_TIMEOUT=180
GEMINI_REFINE_REQUEST_TIMEOUT=300
GEMINI_MAX_RETRIES=5
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_CONCURRENT_CALLS=8
GEMINI_POLISH_CONCURRENCY=1
GEMINI_POLISH_CALL_TIMEOUT=0
GEMINI_REFINE_CALL_TIMEOUT=0
GEMINI_POLISH_MAX_OUTPUT_TOKENS=4096
GEMINI_REFINE_MAX_OUTPUT_TOKENS=60000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FORMAT_MAX_TOKENS=20000
DEEPSEEK_REQUEST_TIMEOUT=180
DEEPSEEK_MAX_RETRIES=4
DEEPSEEK_FORMAT_CALL_TIMEOUT=1800
DEEPSEEK_FORMAT_MAX_CONCURRENT_CALLS=16

QINGDOU_API_KEY=
QINGDOU_BASE_URL=https://www.qingdou.vip/web/api/commitGetTextTask
QINGDOU_MAX_VIDEO_DURATION=0
QINGDOU_POLL_INTERVAL_SECONDS=3
QINGDOU_POLL_TIMEOUT_SECONDS=300
QINGDOU_MAX_CONCURRENT_TASKS=30
QINGDOU_HTTP_MAX_RETRIES=4
QINGDOU_HTTP_RETRY_BACKOFF_SECONDS=2

YOUTUBE_TRANSCRIPT_ENABLED=True
YOUTUBE_TRANSCRIPT_PROVIDERS=youtube_transcript_api,yt_dlp
YOUTUBE_TRANSCRIPT_LANGUAGES=zh-Hans,zh-Hant,zh,en,en-US,en-GB
YOUTUBE_TRANSCRIPT_TOTAL_TIMEOUT_SECONDS=10
YOUTUBE_TRANSCRIPT_TIMEOUT_SECONDS=20
YOUTUBE_TRANSCRIPT_MIN_CHARS=80
YOUTUBE_HTTPS_PROXY=
YOUTUBE_COOKIES_FILE=
YOUTUBE_CACHE_DIR=backend/output/youtube_cache

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=168
CORS_ALLOW_ORIGINS=https://sheke.asia,https://www.sheke.asia
