# ===========================================================
# Gravity Singularity - 环境变量示例
# 复制为 backend/.env 并填入真实值
# ===========================================================

# --- 应用 ---
APP_NAME=GravitySingularity
APP_ENV=development
LOG_LEVEL=INFO

# --- 数据库 (Supabase 托管 Postgres) ---
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres
DATABASE_CONNECT_TIMEOUT=15
DATABASE_POOL_RECYCLE_SECONDS=300

# --- Redis (Upstash 兼容；本地为 redis://localhost:6379/0) ---
REDIS_URL=rediss://default:YOUR_TOKEN@your-instance.upstash.io:6379
CELERY_BROKER_URL=rediss://default:YOUR_TOKEN@your-instance.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:YOUR_TOKEN@your-instance.upstash.io:6379

# --- 主笔模型选择 ---
WRITER_PROVIDER=openai

# --- OpenAI 配置（主笔走这里） ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WRITER_MODEL=gpt-5.5
OPENAI_WRITER_REASONING_EFFORT=high
OPENAI_WRITER_VERBOSITY=medium
OPENAI_WRITER_MAX_OUTPUT_TOKENS=0
OPENAI_WRITER_STREAM=True
OPENAI_PROMPT_CACHE_RETENTION=24h

# --- Testing Endpoint（只使用 OpenAI ChatGPT API；留空则继承 OpenAI 主笔配置） ---
TESTING_ENDPOINT_OPENAI_MODEL=
TESTING_ENDPOINT_OPENAI_REASONING_EFFORT=
TESTING_ENDPOINT_OPENAI_VERBOSITY=
TESTING_ENDPOINT_OPENAI_MAX_OUTPUT_TOKENS=0
TESTING_ENDPOINT_OPENAI_TIMEOUT_SECONDS=1800
TESTING_ENDPOINT_BOOK_CHUNK_CHARS=80000
TESTING_ENDPOINT_STYLE_NOTE_MAX_OUTPUT_TOKENS=2500
TESTING_ENDPOINT_STYLE_PROFILE_MAX_OUTPUT_TOKENS=4000
TESTING_ENDPOINT_VIDEO_MAX_CHARS=160000
TESTING_ENDPOINT_MAX_VIDEO_LINKS=50
TESTING_ENDPOINT_YOUTUBE_TRANSCRIPT_PROVIDERS=youtube_transcript_api,youtube_transcript_ai,pytubefix,yt_dlp,openai_audio

# --- 长篇小说成本控制（模型、推理强度、Prompt 和 workflow 不变） ---
# Flex 按 Batch token 费率计费；后台轮询避免长请求因单条 HTTP 连接超时而重复生成。
LONG_NOVEL_PROCESSING_MODE=flex
LONG_NOVEL_FLEX_BACKGROUND=true
LONG_NOVEL_FLEX_FALLBACK_TO_STANDARD=true
LONG_NOVEL_FLEX_POLL_INTERVAL_SECONDS=5
LONG_NOVEL_FLEX_TIMEOUT_SECONDS=3600
LONG_NOVEL_PROMPT_CACHE_WARMUP=true
LONG_NOVEL_STATE_MAX_OUTPUT_TOKENS=14000
LONG_NOVEL_CONTINUITY_MAX_OUTPUT_TOKENS=10000
LONG_NOVEL_STATE_REASONING_EFFORT=high
LONG_NOVEL_CONTINUITY_REASONING_EFFORT=high

# --- OpenAI 终审（默认关闭） ---
OPENAI_AUDITOR_ENABLED=false
OPENAI_AUDITOR_MODEL=gpt-4o

# --- DeepSeek 退路（保留） ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 图像生成 API (GPT Image / OpenAI 兼容接口) ---
IMAGE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1536

# --- 视频解析 ---
QINGDOU_API_KEY=
QINGDOU_BASE_URL=https://www.qingdou.vip/web/api/commitGetTextTask
YOUTUBE_TRANSCRIPT_ENABLED=True
YOUTUBE_TRANSCRIPT_PROVIDERS=youtube_transcript_api,youtube_transcript_ai,pytubefix,yt_dlp,openai_audio
WECHAT_CHANNELS_PROVIDERS=tikhub,wechatvideodownloader,generic
WECHAT_CHANNELS_TIKHUB_API_KEY=
WECHAT_CHANNELS_DOWNLOADER_API_KEY=
WECHAT_CHANNELS_GENERIC_RESOLVER_URL=
WECHAT_CHANNELS_GENERIC_RESOLVER_API_KEY=

# --- 微信读书推荐值工具 ---
# 版权方全量抓取优先使用微信读书官方 Skill API Key：
# https://weread.qq.com/r/weread-skills 登录后复制 wrk- 开头的 API Key。
WEREAD_API_KEY=
# 兼容旧 Cookie 入口。当前微信读书部分 i.weread App 接口可能不再接受网页 Cookie，
# 所以 Cookie 只能作为兜底，不再保证版权方全量分页。
WEREAD_COOKIE=
# 可选：版权方索引缓存位置，默认写入项目 .local/weread_company_index.json。
WEREAD_COMPANY_INDEX_PATH=

# --- Epic Novel Engine ---
EPIC_EDITOR_MODEL_PROVIDER=
EPIC_EDITOR_MODEL_NAME=
EPIC_AUTHOR_MODEL_PROVIDER=
EPIC_AUTHOR_MODEL_NAME=
EPIC_CHEAP_MODEL_PROVIDER=
EPIC_CHEAP_MODEL_NAME=
EPIC_MAX_PROJECT_COST=
EPIC_MAX_CHAPTER_REPAIR_COUNT=1
EPIC_ENABLE_EDITOR_REVIEW=true
EPIC_ENABLE_REFERENCE_RAG=true
EPIC_ENABLE_WORLD_ATLAS=true
EPIC_ENABLE_MEGA_BIBLE=true
EPIC_ENABLE_REFERENCE_PROFILE=true
EPIC_USE_EXISTING_WRITER_FOR_DRAFTS=true
EPIC_ALLOW_SMOKE_FALLBACK=true
EPIC_STRUCTURED_GENERATION_FALLBACK_TO_EDITOR=true
EPIC_CHAPTER_WRITER_MAX_OUTPUT_TOKENS=0
EPIC_CONTEXT_RECENT_CHAPTER_LIMIT=0
EPIC_CONTEXT_BIBLE_SECTION_LIMIT=0
EPIC_CONTEXT_STATE_LIMIT=0
EPIC_CONTEXT_REFERENCE_CARD_LIMIT=0
EPIC_PROFILE_SUMMARY_ITEM_LIMIT=0
EPIC_REFERENCE_INGEST_SECTION_LIMIT=0
EPIC_REFERENCE_SECTION_CHARS=5000
EPIC_REFERENCE_MODEL_PROVIDER=deepseek
EPIC_REFERENCE_MODEL_NAME=deepseek-v4-pro
EPIC_REFERENCE_ENABLE_LLM_EXTRACTION=true
EPIC_REFERENCE_BATCH_TOKEN_BUDGET=60000
EPIC_REFERENCE_RETRY_FAILED_ONLY=true
EPIC_REFERENCE_FORCE_REINGEST=false
EPIC_REFERENCE_CACHE_BY_HASH=true
EPIC_REFERENCE_EXTRACTION_LANGUAGE=zh-CN
EPIC_CONTEXT_WINDOW_TOKENS=0
EPIC_CONTEXT_PROMPT_BUDGET_RATIO=0.75
EPIC_CONTINUATION_DONE_MARKER=[[EPIC_CHAPTER_DONE]]
EPIC_CONTINUATION_MAX_CHUNKS=8
REFERENCE_RAW_STORAGE=local
REFERENCE_RAW_PATH=.local/novel_ref_corpus/raw
REFERENCE_PROCESSED_PATH=.local/novel_ref_corpus/processed
REFERENCE_DOWNLOAD_PATH=.local/novel_ref_corpus/downloads
EPIC_EXPORT_PATH=.local/epic_novel_exports
EPIC_RUN_ARTIFACT_PATH=.local/epic_novel_runs
REFERENCE_DOWNLOADER_PROVIDER=sonovel
COVER_ORTHODOX_REFERENCE_ZIP_PATH=/app/backend/external_reference_assets/orthodox_publishing/reference_covers.zip
SONOVEL_HOME=C:\Users\15050\Desktop\SoNovel
SONOVEL_DOWNLOAD_PATH=C:\Users\15050\Desktop\SoNovel\downloads
SONOVEL_OUTPUT_FORMAT=epub

# --- 业务硬性指标 (5000字章节墙) ---
CHAPTER_TARGET_WORDS=5000
CHAPTER_MIN_WORDS=4500
SUB_SCENE_OVERLAP_WORDS=800
MAX_PATCH_ROUNDS=3

# --- LLM 调用 ---
LLM_OUTLINE_TEMPERATURE=0.2
LLM_WRITING_TEMPERATURE=0.75
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=3

# --- CORS ---
CORS_ALLOW_ORIGINS=*
# Optional global final-manuscript AIGC gate (Tencent Text Moderation TEXT_AIGC)
AIGC_GATE_ENABLED=False
VITE_AIGC_GATE_ENABLED=false
AIGC_GATE_FAIL_CLOSED=True
AIGC_GATE_THRESHOLD=50
AIGC_GATE_MAX_REWRITE_ROUNDS=2
AIGC_GATE_CHUNK_MIN_CHARS=350
AIGC_GATE_CHUNK_MAX_CHARS=1800
AIGC_GATE_DETECT_CONCURRENCY=4
AIGC_GATE_REWRITE_CONCURRENCY=2
AIGC_GATE_REWRITE_TEMPERATURE=0.85
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_AIGC_BIZ_TYPE=
TENCENT_AIGC_REGION=ap-beijing
# Independent report-driven Zhuque review page (does not enable the global gate)
AIGC_REVIEW_REWRITE_MODEL=deepseek-v4-pro
AIGC_REVIEW_REWRITE_PROVIDER=deepseek
AIGC_REVIEW_GROK_MODEL=grok-4.5
AIGC_REVIEW_GROK_REASONING_EFFORT=low
AIGC_REVIEW_GROK_MAX_OUTPUT_TOKENS=12000
AIGC_REVIEW_GROK_INPUT_USD_PER_M=2
AIGC_REVIEW_GROK_CACHED_INPUT_USD_PER_M=0.5
AIGC_REVIEW_GROK_OUTPUT_USD_PER_M=6
AIGC_REVIEW_USD_CNY_RATE=7.2
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_HTTPS_PROXY=
XAI_REQUEST_TIMEOUT=600
XAI_MAX_RETRIES=2
AIGC_REVIEW_AUDIT_MODEL=gemini-3.1-flash-lite
AIGC_REVIEW_HUMAN_TARGET=25
AIGC_REVIEW_EDITORIAL_UNIT_MIN_CHARS=600
AIGC_REVIEW_EDITORIAL_UNIT_MAX_CHARS=900
AIGC_REVIEW_MACRO_BLOCK_MIN_CHARS=1200
AIGC_REVIEW_MACRO_BLOCK_MAX_CHARS=2500
AIGC_REVIEW_AUDIT_BATCH_UNITS=1
AIGC_REVIEW_AUDIT_MAX_OUTPUT_TOKENS=6000
AIGC_REVIEW_RUN_BUDGET_CNY=0.30
AIGC_REVIEW_CALIBRATION_BUDGET_CNY=0.30
AIGC_REVIEW_MAX_MANUSCRIPT_CHARS=200000
AIGC_REVIEW_MAX_PDF_BYTES=30000000
AIGC_REVIEW_MAX_PDF_PAGES=40
AIGC_REVIEW_OCR_SCALE=1.5
AIGC_REVIEW_OCR_RETRY_SCALE=2.2
AIGC_REVIEW_OCR_MAX_SCAN_PAGES=6
